<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Editor colours, light theme (the original palette). Same keys in Dark.xaml. -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.PanelAltBackground" Color="#FFF9FAFB" />
    <SolidColorBrush x:Key="Theme.InactivePanelBackground" Color="#FFFFF7ED" />
    <SolidColorBrush x:Key="Theme.SubtleBorder" Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="Theme.Border" Color="#FFD1D5DB" />
    <SolidColorBrush x:Key="Theme.InputBorder" Color="#FFABADB3" />
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#FF111827" />
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#FF374151" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#FF6B7280" />
    <SolidColorBrush x:Key="Theme.TextFaint" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF2563EB" />
    <SolidColorBrush x:Key="Theme.Changed" Color="#FFFF0000" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#FF8B0000" />
    <SolidColorBrush x:Key="Theme.Success" Color="#FF2E8B57" />
    <SolidColorBrush x:Key="Theme.Notice" Color="#FFB8860B" />
</ResourceDictionary>
