<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Editor colours, dark theme. Same keys in Light.xaml. -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FF1B1C1F" />
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FF25272B" />
    <SolidColorBrush x:Key="Theme.PanelAltBackground" Color="#FF2C2F34" />
    <SolidColorBrush x:Key="Theme.InactivePanelBackground" Color="#FF3A2E22" />
    <SolidColorBrush x:Key="Theme.SubtleBorder" Color="#FF363A40" />
    <SolidColorBrush x:Key="Theme.Border" Color="#FF464A51" />
    <SolidColorBrush x:Key="Theme.InputBorder" Color="#FF5A5F67" />
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#FFE8E9EB" />
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#FFC9CCD1" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#FF9BA1A9" />
    <SolidColorBrush x:Key="Theme.TextFaint" Color="#FF7A808A" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Theme.Changed" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#FFF59E8B" />
    <SolidColorBrush x:Key="Theme.Success" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Theme.Notice" Color="#FFFACC15" />
</ResourceDictionary>
