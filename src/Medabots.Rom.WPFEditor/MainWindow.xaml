<Window x:Class="Medabots.Rom.WPFEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medabots.Rom.WPFEditor"
        xmlns:localModels="clr-namespace:Medabots.Rom.WPFEditor.Models"
        xmlns:editorModels="clr-namespace:Medabots.Rom.Editor"
        mc:Ignorable="d"
        Title="Medabots ROM WPF Editor"
        Height="980"
        Width="1540"
        MinHeight="760"
        MinWidth="1200"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <localModels:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <DataTemplate x:Key="BrowserItemChangeTemplate" DataType="{x:Type editorModels:BrowserItem}">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Changed}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="BattleLoadoutOptionTemplate" DataType="{x:Type localModels:BattleLoadoutOption}">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="Transparent" VerticalAlignment="Center">
                    <Image Source="{Binding Thumbnail}" Width="36" Height="36" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItemsPanelTemplate">
            <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="MapSpawnSpriteOptionTemplate" DataType="{x:Type localModels:MapSpawnSpriteOption}">
            <StackPanel Width="92" Margin="2">
                <Border Width="48" Height="72" HorizontalAlignment="Center" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="Transparent">
                    <Image Source="{Binding Thumbnail}" Width="48" Height="72" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource Theme.TextMuted}" Text="{Binding Subtitle}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MapSpawnFacingOptionTemplate" DataType="{x:Type localModels:MapSpawnFacingOption}">
            <StackPanel Width="86" Margin="2">
                <Border Width="48" Height="72" HorizontalAlignment="Center" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="Transparent">
                    <Image Source="{Binding Thumbnail}" Width="48" Height="72" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MapSpriteSlotOptionTemplate" DataType="{x:Type localModels:MapSpriteSlotOption}">
            <Border Width="24" Height="32" Margin="0.5" Padding="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="{DynamicResource Theme.PanelBackground}" ToolTip="{Binding Subtitle}">
                <Image HorizontalAlignment="Center"
                       Width="16"
                       Height="24"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Source="{Binding Thumbnail}" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Visibility="Collapsed" Height="0">
            <TextBox x:Name="ProjectPathEntry" />
            <TextBox x:Name="RomPathEntry" />
            <TextBlock x:Name="ProjectNameLabel" />
            <TextBlock x:Name="ProfileStatusLabel" />
            <TextBlock x:Name="SessionStatusLabel" />
            <TextBlock x:Name="RomSizeLabel" />
            <TextBlock x:Name="PatchCountLabel" />
            <TextBlock x:Name="LoadingStatusLabel" Visibility="Collapsed" />
            <ProgressBar x:Name="LoadingProgressBar" Visibility="Collapsed" />
        </Grid>

        <Menu DockPanel.Dock="Top" Background="{DynamicResource Theme.WindowBackground}">
            <MenuItem Header="_File">
                <MenuItem x:Name="OpenRomCommandButton" Header="Open ROM..." Click="OnOpenRomClicked" />
                <MenuItem x:Name="OpenProjectCommandButton" Header="Open Project..." Click="OnLoadProjectClicked" />
                <MenuItem x:Name="GenerateExpandedRomCommandButton" Header="Generate Expanded ROM..." Click="OnGenerateExpandedRomClicked" />
                <Separator />
                <MenuItem x:Name="SaveProjectCommandButton" Header="Save Project" Click="OnSaveProjectClicked" />
                <MenuItem x:Name="ExportRomCommandButton" Header="Export ROM" Click="OnSaveCopyClicked" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="_View" SubmenuOpened="OnViewMenuOpened">
                <MenuItem x:Name="DarkModeMenuItem" Header="_Dark mode" IsCheckable="True" Click="OnDarkModeClicked" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.PanelBackground}">
            <StatusBarItem Width="420">
                <TextBlock x:Name="FooterProjectLabel" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Width="540">
                <TextBlock x:Name="FooterChangesLabel" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="FooterPathLabel" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="EditorTabControl" Margin="12">
            <TabItem x:Name="MessagesSection" Header="Messages">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MessageFilterEntry" Grid.Column="0" TextChanged="OnMessageFilterChanged" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Click="OnAddPatchClicked">Add</Button>
                            </Grid>
                            <ListBox x:Name="PatchCollectionView" Grid.Row="1" SelectionChanged="OnPatchSelectionChanged" DisplayMemberPath="DisplayName" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Message Details" FontWeight="SemiBold" FontSize="14" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">Bank</TextBlock>
                                    <TextBox x:Name="BankEntry" Grid.Column="1" />
                                    <TextBlock Grid.Column="2" Margin="16,0,8,0" VerticalAlignment="Center">Index</TextBlock>
                                    <TextBox x:Name="IndexEntry" Grid.Column="3" />
                                </Grid>
                                <TextBox x:Name="MessageTextEditor" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="160" MaxHeight="320" TextChanged="OnMessageTextEditorTextChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Margin="0,0,8,0" Click="OnSavePatchChangesClicked">Save Patch</Button>
                                    <Button Click="OnRemovePatchClicked">Remove Patch</Button>
                                </StackPanel>
                                <TextBlock Margin="0,18,0,0" Text="Preview (as the game shows it)" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="&#x25C0; Previous box" Padding="10,3" Click="OnMessagePreviewPreviousClicked" />
                                    <Button Content="Next box &#x25B6;" Padding="10,3" Margin="6,0,0,0" Click="OnMessagePreviewNextClicked" />
                                </StackPanel>
                                <Border Margin="0,8,0,0" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}">
                                    <Image x:Name="MessagePreviewImage" Width="480" Height="320" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock x:Name="MessagePreviewLabel" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="EventsSection" Header="Events">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBox x:Name="EventFilterEntry"
                                         TextChanged="OnEventFilterChanged"
                                         ToolTip="Plain text search, or use op:0x84 / opcode:Focus_Event_Object" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Theme.TextMuted}"
                                           FontSize="11"
                                           Text="Search text, or filter by opcode with op:0x84 or opcode:Focus_Event_Object." />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,8" Background="{DynamicResource Theme.WindowBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="8,6" FontWeight="SemiBold">Id</TextBlock>
                                <TextBlock Grid.Column="1" Margin="8,6" FontWeight="SemiBold">Summary</TextBlock>
                            </Grid>
                            <ListBox x:Name="EventCollectionView" Grid.Row="2" SelectionChanged="OnEventSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6" Tag="{Binding}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Revert Event Patch" Click="OnRevertEventPatchMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat=D4}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Event Flow" FontWeight="SemiBold" FontSize="14" />
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="EventInstructionCollectionView" Grid.Column="0" SelectionChanged="OnEventInstructionSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" BorderBrush="{DynamicResource Theme.SubtleBorder}" BorderThickness="0,0,0,1" Tag="{Binding}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Rename Label" Click="OnRenameEventLabelMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Insert Selected Operation Before" Click="OnInsertSelectedOperationBeforeMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Insert Selected Operation After" Click="OnInsertSelectedOperationAfterMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Insert Nop Before" Click="OnInsertEventNopBeforeMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Insert Nop After" Click="OnInsertEventNopAfterMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Delete Instruction" Click="OnDeleteEventInstructionMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding AccentColor}" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <DockPanel>
                                                            <Border Background="{Binding CategoryBackgroundColor}" Padding="7,2" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,8,0" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Category}" Foreground="{Binding CategoryTextColor}" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding LabelDisplay, StringFormat={}{0}:}" Foreground="{DynamicResource Theme.Accent}" FontSize="11" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimary}" />
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Selected Action" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EventActionTitleLabel" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="EventActionHintLabel" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                            <TextBlock Text="Known Labels" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" />
                                            <TextBlock x:Name="EventKnownLabelsLabel" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Accent}" />
                                        </StackPanel>
                                        <Grid Grid.Row="4" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="EventOperationPicker" SelectionChanged="OnEventOperationSelectionChanged" />
                                            <Button Grid.Column="1" Margin="8,0,0,0">Tools
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit Selected Label" Click="OnEditSelectedEventLabelClicked" />
                                                        <MenuItem Header="Revert Event Patch" Click="OnRevertEventPatchClicked" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="Labels can be used directly in jump arguments." Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                        <local:EventStructuralActionsControl Grid.Row="6"
                                                                            InsertNopBeforeClick="OnSelectedEventInsertNopBeforeClicked"
                                                                            InsertNopAfterClick="OnSelectedEventInsertNopAfterClicked"
                                                                            InsertSelectedOperationBeforeClick="OnSelectedEventInsertOperationBeforeClicked"
                                                                            InsertSelectedOperationAfterClick="OnSelectedEventInsertOperationAfterClicked"
                                                                            MoveUpClick="OnSelectedEventMoveUpClicked"
                                                                            MoveDownClick="OnSelectedEventMoveDownClicked"
                                                                            DeleteClick="OnSelectedEventDeleteClicked" />
                                        <ListBox x:Name="EventArgumentCollectionView" Grid.Row="7" Margin="0,10,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" />
                                                        <TextBox Margin="0,4,0,0" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPlainValueEditor, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding EnumOptions}" SelectedIndex="{Binding SelectedEnumIndex}" Visibility="{Binding IsEnumEditor, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Grid Margin="0,4,0,0" Visibility="{Binding IsMoveEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox Grid.Column="0" ItemsSource="{Binding EnumOptions}" SelectedIndex="{Binding MoveDirectionIndex}" />
                                                            <TextBox Grid.Column="2" Text="{Binding MoveDistanceText, UpdateSourceTrigger=PropertyChanged}" />
                                                            <CheckBox Grid.Column="4"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsMoveUnused}"
                                                                      Content="Unused" />
                                                        </Grid>
                                                        <Grid Margin="0,4,0,0" Visibility="{Binding IsPackedTrackedObjectIdEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding TrackedObjectSlotText, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBox Grid.Column="2" Text="{Binding PackedFlagsText, UpdateSourceTrigger=PropertyChanged}" />
                                                        </Grid>
                                                        <StackPanel Margin="0,4,0,0" Visibility="{Binding IsJumpTargetEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ComboBox ItemsSource="{Binding JumpTargetOptions}" SelectedIndex="{Binding SelectedJumpTargetIndex}" />
                                                            <TextBlock Margin="0,4,0,0" Text="{Binding HelpText}" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding HelpText}" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" Visibility="{Binding ShowStandardHelpText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Grid.Row="8" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnApplyEventActionClicked">Apply Action Changes</Button>
                                        <TextBlock x:Name="EventPatchStatusLabel" Grid.Row="9" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="BattlesSection" Header="Robobattles">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="BattleFilterEntry" TextChanged="OnBattleFilterChanged" />
                            <ListBox x:Name="BattleCollectionView"
                                     Grid.Row="1"
                                     Margin="0,10,0,0"
                                     SelectionChanged="OnBattleSelectionChanged"
                                     ItemTemplate="{StaticResource BrowserItemChangeTemplate}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Robobattle Details" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" HorizontalAlignment="Right" Click="OnResetBattleClicked">Reset</Button>
                                </Grid>
                                <Border Margin="0,12,0,0" BorderBrush="{DynamicResource Theme.SubtleBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel>
                                        <TextBlock x:Name="BattleOverviewLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="BattleOverviewHintLabel" Margin="0,6,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,14,0,0" Text="Core Fields" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Battle Owner / Character" FontWeight="SemiBold" />
                                        <ComboBox x:Name="BattleCharacterEntry" Margin="0,4,0,0" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="OnBattleLoadoutSelectionChanged" />
                                        <TextBlock x:Name="BattleCharacterHintLabel" Visibility="Collapsed" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Active Bots" FontWeight="SemiBold" />
                                        <ComboBox x:Name="BattleBotCountEntry" Margin="0,4,0,0" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="OnBattleLoadoutSelectionChanged" />
                                        <TextBlock x:Name="BattleBotCountHintLabel" Visibility="Collapsed" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Roborobo Medal Reward" FontWeight="SemiBold" />
                                        <ComboBox x:Name="BattleInitializationModeEntry" Margin="0,4,0,0" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="OnBattleLoadoutSelectionChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
