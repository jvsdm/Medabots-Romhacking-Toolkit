                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="PartValue3Label" FontWeight="SemiBold" />
                                            <TextBox x:Name="PartValue3Entry" Margin="0,4,0,0" />
                                            <TextBlock x:Name="PartValue3HintLabel" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="PartValue4Label" FontWeight="SemiBold" />
                                            <TextBox x:Name="PartValue4Entry" Margin="0,4,0,0" />
                                            <CheckBox x:Name="PartValue4CheckBox"
                                                      Margin="0,8,0,0"
                                                      Content="Enabled"
                                                      Visibility="Collapsed" />
                                            <TextBlock x:Name="PartValue4HintLabel" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="PartValue5Label" FontWeight="SemiBold" />
                                        <TextBox x:Name="PartValue5Entry" Margin="0,4,0,0" />
                                        <TextBlock x:Name="PartValue5HintLabel" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Margin="0,14,0,0" Text="Derived / Scaling Fields" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="PartUnknown2Label" FontWeight="SemiBold">Unknown2</TextBlock>
                                            <TextBox x:Name="PartUnknown2Entry" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="PartUnknown4Label" FontWeight="SemiBold">Unknown4</TextBlock>
                                            <TextBox x:Name="PartUnknown4Entry" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="PartUnknown5Label" FontWeight="SemiBold">Unknown5</TextBlock>
                                        <TextBox x:Name="PartUnknown5Entry" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <TextBlock x:Name="PartUnknown2HintLabel"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="PartUnknown45HintLabel"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               TextWrapping="Wrap" />

                                    <Expander Margin="0,14,0,0" Header="Advanced / Unresolved Fields">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="These bytes are preserved on save, but their full gameplay meaning is still being reverse engineered." Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                            <UniformGrid Margin="0,10,0,0" Columns="2">
                                                <TextBlock x:Name="PartUnknown3Label" VerticalAlignment="Center">Bot Shared Value</TextBlock>
                                                <TextBox x:Name="PartUnknown3Entry" />
                                            </UniformGrid>
                                            <TextBlock x:Name="PartUnknown3HintLabel"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource Theme.TextMuted}"
                                                       TextWrapping="Wrap" />
                                            <UniformGrid Margin="0,8,0,0" Columns="4">
                                                <TextBlock VerticalAlignment="Center">Reserved Tail A</TextBlock>
                                                <TextBox x:Name="PartUnknown6Entry" Margin="0,0,16,0" />
                                                <TextBlock VerticalAlignment="Center">Reserved Tail B</TextBlock>
                                                <TextBox x:Name="PartUnknown7Entry" />
                                            </UniformGrid>
                                            <UniformGrid Margin="0,8,0,0" Columns="2">
                                                <TextBlock VerticalAlignment="Center">Reserved Tail C</TextBlock>
                                                <TextBox x:Name="PartUnknown8Entry" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="MapsSection" Header="Maps" PreviewKeyDown="OnMapsPreviewKeyDown">
                <Grid Margin="0,8,0,0" PreviewMouseDown="OnMapEditorRootPreviewMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MapFilterEntry" TextChanged="OnMapFilterChanged" VerticalContentAlignment="Center" />
                                <Button x:Name="AddMapCommandButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Width="34"
                                        Height="30"
                                        Padding="0,-4,0,0"
                                        Content="+"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Style="{StaticResource AddButtonStyle}"
                                        ToolTip="New map: a copy of an existing map (layers, tileset, collision, music) in the next free map ID"
                                        Click="OnAddMapClicked" />
                            </Grid>
                            <ListBox x:Name="MapCollectionView"
                                     Grid.Row="1"
                                     Margin="0,10,0,0"
                                     SelectionChanged="OnMapSelectionChanged"
                                     MouseDoubleClick="OnMapListDoubleClicked"
                                     ToolTip="Double-click a map to rename it (an editor label saved in the project; the game has no map names)"
                                     DisplayMemberPath="Title"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Map Editor" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="MapSummaryLabel" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            <!-- Map editor options: three groups that wrap instead of overflowing (Fluent check boxes have MinWidth 120 by default). -->
                            <WrapPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal">
                                <Border Margin="0,0,10,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tool" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,10,0" />
                                        <RadioButton x:Name="MapToolPencilButton" GroupName="MapTool" Tag="Pencil" Content="Pencil" ToolTip="Pencil (P): click or drag; stamps the tiles selected in the palette" MinWidth="0" Padding="8,3" Margin="0,0,4,0" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnMapToolChecked" />
                                        <RadioButton x:Name="MapToolLineButton" GroupName="MapTool" Tag="Line" Content="Line" ToolTip="Line (L): drag from start to end" MinWidth="0" Padding="8,3" Margin="0,0,4,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnMapToolChecked" />
                                        <RadioButton x:Name="MapToolRectangleButton" GroupName="MapTool" Tag="Rectangle" Content="Rect" ToolTip="Rectangle outline (R): drag a corner to the opposite one" MinWidth="0" Padding="8,3" Margin="0,0,4,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnMapToolChecked" />
                                        <RadioButton x:Name="MapToolFilledRectangleButton" GroupName="MapTool" Tag="FilledRectangle" Content="Fill rect" ToolTip="Filled rectangle (F): drag a corner to the opposite one" MinWidth="0" Padding="8,3" Margin="0,0,4,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnMapToolChecked" />
                                        <RadioButton x:Name="MapToolBucketButton" GroupName="MapTool" Tag="Bucket" Content="Bucket" ToolTip="Bucket fill (G): fills the connected area of identical tiles (or collision values)" MinWidth="0" Padding="8,3" Margin="0,0,4,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnMapToolChecked" />
                                        <RadioButton x:Name="MapToolPickerButton" GroupName="MapTool" Tag="Picker" Content="Picker" ToolTip="Picker (I): takes the tile (or collision value) under the cursor, then back to the pencil" MinWidth="0" Padding="8,3" Margin="0,0,4,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="OnMapToolChecked" />
                                        <Button Content="Undo" Margin="10,0,4,0" Padding="8,3" ToolTip="Undo (Ctrl+Z)" Click="OnMapUndoClicked" />
                                        <Button Content="Redo" Padding="8,3" ToolTip="Redo (Ctrl+Y)" Click="OnMapRedoClicked" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Edit" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,10,0" />
                                        <ComboBox x:Name="MapEditLayerComboBox" Width="130" SelectionChanged="OnMapEditLayerSelectionChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Show" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,10,0" />
                                        <CheckBox x:Name="MapLayer1VisibilityCheckBox" Content="L1" IsChecked="True" MinWidth="0" Margin="0,0,0,0" VerticalAlignment="Center" Checked="OnMapLayerVisibilityChanged" Unchecked="OnMapLayerVisibilityChanged" />
                                        <CheckBox x:Name="MapLayer2VisibilityCheckBox" Content="L2" IsChecked="True" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Checked="OnMapLayerVisibilityChanged" Unchecked="OnMapLayerVisibilityChanged" />
                                        <CheckBox x:Name="MapLayer3VisibilityCheckBox" Content="L3" IsChecked="True" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Checked="OnMapLayerVisibilityChanged" Unchecked="OnMapLayerVisibilityChanged" />
                                        <CheckBox x:Name="MapCollisionVisibilityCheckBox" Content="Collision" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Checked="OnMapLayerVisibilityChanged" Unchecked="OnMapLayerVisibilityChanged" />
                                        <CheckBox x:Name="MapEventsVisibilityCheckBox" Content="Events" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Checked="OnMapLayerVisibilityChanged" Unchecked="OnMapLayerVisibilityChanged" />
                                        <CheckBox x:Name="MapWarpsVisibilityCheckBox" Content="Warps" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Checked="OnMapLayerVisibilityChanged" Unchecked="OnMapLayerVisibilityChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Chapter" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,10,0" />
                                        <ComboBox x:Name="MapEventChapterFilterComboBox" Width="150" SelectionChanged="OnMapEventChapterFilterChanged" />
                                        <TextBlock x:Name="MapZoomValueLabel" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" Text="Zoom 2x" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="MapTilesetSummaryLabel" Grid.Row="0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                <Border Grid.Row="1"
                                        Margin="0,10,0,0"
                                        MinHeight="240"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Theme.PanelAltBackground}"
                                        Padding="8">
                                    <ScrollViewer x:Name="MapPreviewScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  SizeChanged="OnMapPreviewViewportSizeChanged"
                                                  PreviewMouseDown="OnMapPreviewScrollViewerMouseDown"
                                                  PreviewMouseMove="OnMapPreviewScrollViewerMouseMove"
                                                  PreviewMouseUp="OnMapPreviewScrollViewerMouseUp"
                                                  PreviewMouseWheel="OnMapPreviewMouseWheel">
                                        <Border x:Name="MapPreviewPaddingBorder" Padding="96" Background="Transparent">
                                            <Grid x:Name="MapPreviewSurface"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top">
                                                <Image x:Name="MapCompositePreviewImage"
                                                       MouseLeftButtonDown="OnMapCompositePreviewMouseLeftButtonDown"
                                                       MouseLeftButtonUp="OnMapCompositePreviewMouseLeftButtonUp"
                                                       MouseRightButtonDown="OnMapCompositePreviewMouseRightButtonDown"
                                                       MouseMove="OnMapCompositePreviewMouseMove"
                                                       MouseLeave="OnMapCompositePreviewMouseLeave"
                                                       ContextMenuOpening="OnMapCompositePreviewContextMenuOpening"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Stretch="Fill"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                    <Image.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem x:Name="AddMapEventContextMenuItem" Header="Add Event Here" Click="OnAddMapEventHereClicked" />
                                                            <MenuItem x:Name="DeleteMapEventContextMenuItem" Header="Delete Selected Event" Click="OnDeleteMapEventClicked" />
                                                            <Separator x:Name="MapEventContextMenuSeparator" />
                                                            <MenuItem x:Name="AddMapWarpContextMenuItem" Header="Add Warp Here" Click="OnAddMapWarpHereClicked" />
                                                            <MenuItem x:Name="DeleteMapWarpContextMenuItem" Header="Delete Selected Warp" Click="OnDeleteMapWarpClicked" />
                                                        </ContextMenu>
                                                    </Image.ContextMenu>
                                                </Image>
                                                <Canvas x:Name="MapGridCanvas"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock x:Name="MapOverlayStatusLabel" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="MapMetadataEditorPanel" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Map Metadata" FontWeight="SemiBold" FontSize="14" />
                                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource Theme.SubtleBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource Theme.PanelAltBackground}">
                                        <TextBlock x:Name="MapMetadataOverviewLabel" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Margin="0,12,0,0" Text="Map Size" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Width (tiles)" />
                                            <TextBox x:Name="MapWidthEntry" Margin="0,4,0,0" TextChanged="OnMapResizeTextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Height (tiles)" />
                                            <TextBox x:Name="MapHeightEntry" Margin="0,4,0,0" TextChanged="OnMapResizeTextChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="MapResizeHintLabel"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               TextWrapping="Wrap"
                                               Text="Resize is staged immediately. Existing tiles are copied from the top-left; new space is filled with empty tiles." />
                                    <TextBlock Margin="0,12,0,0" Text="Music" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <ComboBox x:Name="MapMusicComboBox"
                                              Margin="0,6,0,0"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Id"
                                              SelectionChanged="OnMapMetadataChanged" />
                                    <CheckBox x:Name="MapHasEncountersCheckBox"
                                              Margin="0,12,0,0"
                                              Content="Has Encounters"
                                              Checked="OnMapMetadataChanged"
                                              Unchecked="OnMapMetadataChanged" />
                                    <StackPanel x:Name="MapEncounterFieldsPanel"
                                                Visibility="{Binding IsChecked, ElementName=MapHasEncountersCheckBox, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Margin="0,12,0,0" Text="Encounters" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <UniformGrid Margin="0,6,0,0" Columns="2">
                                        <TextBlock VerticalAlignment="Center">Battle 1</TextBlock>
                                        <ComboBox x:Name="MapEncounterBattle1ComboBox"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectionChanged="OnMapMetadataChanged" />
                                    </UniformGrid>
                                    <UniformGrid Margin="0,6,0,0" Columns="2">
                                        <TextBlock VerticalAlignment="Center">Battle 2</TextBlock>
                                        <ComboBox x:Name="MapEncounterBattle2ComboBox"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectionChanged="OnMapMetadataChanged" />
                                    </UniformGrid>
                                    <UniformGrid Margin="0,6,0,0" Columns="2">
                                        <TextBlock VerticalAlignment="Center">Battle 3</TextBlock>
                                        <ComboBox x:Name="MapEncounterBattle3ComboBox"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectionChanged="OnMapMetadataChanged" />
                                    </UniformGrid>
                                    <UniformGrid Margin="0,6,0,0" Columns="2">
                                        <TextBlock VerticalAlignment="Center">Battle 4</TextBlock>
                                        <ComboBox x:Name="MapEncounterBattle4ComboBox"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectionChanged="OnMapMetadataChanged" />
                                    </UniformGrid>
                                    </StackPanel>
                                    <TextBlock Margin="0,12,0,0" Text="Sprite Slots" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <Border Margin="0,8,0,0"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1"
                                            Background="{DynamicResource Theme.PanelAltBackground}"
                                            Padding="8">
                                        <StackPanel>
                                            <ListBox x:Name="MapSpriteSlotListBox"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     PreviewMouseLeftButtonUp="OnMapSpriteSlotListBoxPreviewMouseLeftButtonUp"
                                                     SelectionChanged="OnMapSpriteSlotSelectionChanged">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid IsItemsHost="True" Columns="8" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="24" Height="32" Margin="0.5" Padding="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="{DynamicResource Theme.PanelBackground}">
                                                            <StackPanel>
                                                                <Image HorizontalAlignment="Center"
                                                                       Width="16"
                                                                       Height="24"
                                                                       Stretch="Uniform"
                                                                       SnapsToDevicePixels="True"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                       Source="{Binding Thumbnail}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Popup x:Name="MapSpriteSlotPickerPopup"
                                                   Placement="Bottom"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   Closed="OnMapSpriteSlotPickerPopupClosed">
                                                <Border Margin="0,6,0,0"
                                                        Padding="8"
                                                        Background="{DynamicResource Theme.PanelBackground}"
                                                        BorderBrush="{DynamicResource Theme.Border}"
                                                        BorderThickness="1">
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  MaxHeight="280">
                                                        <ListBox x:Name="MapSelectedSpriteSlotOptionsListBox"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 PreviewMouseWheel="OnMapSelectedSpriteSlotOptionsListBoxPreviewMouseWheel"
                                                                 SelectionChanged="OnMapSelectedSpriteSlotOptionChanged"
                                                                 ItemTemplate="{StaticResource MapSpriteSlotOptionTemplate}">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid IsItemsHost="True" Columns="8" />
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                        </ListBox>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="RevertMapMetadataChangesButton"
                                                HorizontalAlignment="Left"
                                                Click="OnRevertMapMetadataChangesClicked">Reset</Button>
                                    </StackPanel>
                                    <TextBlock x:Name="MapMetadataStatusLabel"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.TextMuted}" />
                                </StackPanel>

                                <TextBlock x:Name="MapEditorTitleLabel" Text="Layer Editor" FontWeight="SemiBold" FontSize="14" />

                                <StackPanel x:Name="MapTileEditorPanel" Margin="0,12,0,0">
                                    <TextBlock Text="Tilemap Layer" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <TextBlock Margin="0,12,0,0" Text="Tileset Source" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <Grid Margin="0,6,0,0">
                                        <ComboBox x:Name="MapTilesetComboBox"
                                                  HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="RepresentativeMapId"
                                                  SelectionChanged="OnMapTilesetSelectionChanged" />
                                    </Grid>
                                    <TextBlock Margin="0,12,0,0" Text="This map's tileset as PNG" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <Button Content="Export tileset..." HorizontalAlignment="Stretch" Margin="0,0,3,3" Click="OnExportMapTilesetClicked" ToolTip="16 tiles per row, colour 0 transparent, each tile in the palette row it is shown with" />
                                        <Button Content="Import tileset..." HorizontalAlignment="Stretch" Margin="3,0,0,3" Click="OnImportMapTilesetClicked" ToolTip="Same size as the export; colours snap to the tile's palette row" />
                                        <Button Content="Export palettes..." HorizontalAlignment="Stretch" Margin="0,3,3,0" Click="OnExportMapPaletteClicked" ToolTip="16 x 16 grid: one row per palette bank" />
                                        <Button Content="Import palettes..." HorizontalAlignment="Stretch" Margin="3,3,0,0" Click="OnImportMapPaletteClicked" ToolTip="A 16 x 16 colour grid (e.g. the exported 256x256 picture)" />
                                    </UniformGrid>
                                    <TextBlock Margin="0,12,0,0" Text="Tile Palette" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <Border Margin="0,8,0,0"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1"
                                            Background="{DynamicResource Theme.PanelAltBackground}"
                                            Padding="8">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      MaxHeight="420">
                                            <Image x:Name="MapTilesetPaletteImage"
                                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Stretch"
                                                   SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   MouseLeftButtonDown="OnMapTilesetPaletteMouseLeftButtonDown"
                                                   MouseMove="OnMapTilesetPaletteMouseMove"
                                                   MouseLeftButtonUp="OnMapTilesetPaletteMouseLeftButtonUp" />
                                        </ScrollViewer>
                                    </Border>
                                    <TextBlock x:Name="MapTilesetPaletteStatusLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                    <TextBlock x:Name="MapTileEditorStatusLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                </StackPanel>

                                <StackPanel x:Name="MapCollisionEditorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Collision Layer" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <TextBlock Margin="0,8,0,0" Text="Collision Value" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <ComboBox x:Name="MapCollisionValueComboBox"
                                              Margin="0,6,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectionChanged="OnMapCollisionValueSelectionChanged" />
                                    <TextBlock x:Name="MapCollisionEditorStatusLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                </StackPanel>

                                <StackPanel x:Name="MapOverlayEditorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Selected Overlay" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                    <Border x:Name="MapOverlayPreviewBorder"
                                            Margin="0,10,0,0"
                                            Padding="8"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1"
                                            Background="{DynamicResource Theme.PanelAltBackground}"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="MapOverlayPreviewLabel"
                                                       Margin="0,0,0,8"
                                                       Foreground="{DynamicResource Theme.TextMuted}"
                                                       TextWrapping="Wrap" />
                                            <Image x:Name="MapOverlayPreviewImage"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Stretch="None"
                                                   SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="MapWarpFieldsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Warp Fields" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <UniformGrid Margin="0,8,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Tile X</TextBlock>
                                            <TextBox x:Name="MapWarpTileXEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Tile Y</TextBlock>
                                            <TextBox x:Name="MapWarpTileYEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Destination Map</TextBlock>
                                            <TextBox x:Name="MapWarpDestinationMapEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Destination Tile X</TextBlock>
                                            <TextBox x:Name="MapWarpDestinationTileXEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Destination Tile Y</TextBlock>
                                            <TextBox x:Name="MapWarpDestinationTileYEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Arrival Facing</TextBlock>
                                            <TextBox x:Name="MapWarpArrivalFacingEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Transition Kind</TextBlock>
                                            <TextBox x:Name="MapWarpTransitionKindEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Unknown 4</TextBlock>
                                            <TextBox x:Name="MapWarpUnknown4Entry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Unknown 5</TextBlock>
                                            <TextBox x:Name="MapWarpUnknown5Entry" />
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="MapEventSpawnFieldsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Event / Spawn Fields" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <UniformGrid Margin="0,8,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Tile X</TextBlock>
                                            <TextBox x:Name="MapSpawnTileXEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Tile Y</TextBlock>
                                            <TextBox x:Name="MapSpawnTileYEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Record Kind</TextBlock>
                                            <TextBox x:Name="MapSpawnRecordKindEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Event / Object Id</TextBlock>
                                            <TextBox x:Name="MapSpawnEventOrObjectIdEntry" />
                                        </UniformGrid>
                                        <TextBlock Margin="0,6,0,0" Text="Character" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <ComboBox x:Name="MapSpawnSpriteComboBox"
                                                  Margin="0,6,0,0"
                                                  ItemTemplate="{StaticResource MapSpawnSpriteOptionTemplate}"
                                                  SelectionChanged="OnMapSpawnSpriteSelectionChanged"
                                                  MaxDropDownHeight="420"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <TextBlock Margin="0,10,0,0" Text="Facing" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <ComboBox x:Name="MapSpawnFacingComboBox"
                                                  Margin="0,6,0,0"
                                                  ItemTemplate="{StaticResource MapSpawnFacingOptionTemplate}"
                                                  MaxDropDownHeight="240"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Spawn Group</TextBlock>
                                            <TextBox x:Name="MapSpawnGroupEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <TextBlock VerticalAlignment="Center">Chapter Mask</TextBlock>
                                            <TextBox x:Name="MapSpawnChapterMaskEntry" />
                                        </UniformGrid>
                                        <TextBlock x:Name="MapOverlayScriptSummaryHeader"
                                                   Margin="0,12,0,0"
                                                   Text="Linked Event Script"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                                   Visibility="Collapsed" />
                                        <TextBox x:Name="MapOverlayScriptSummaryTextBox"
                                                 Margin="0,8,0,0"
                                                 MinHeight="180"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Visibility="Collapsed" />
                                        <Button x:Name="OpenMapOverlayEventScriptEditorButton"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Click="OnOpenMapOverlayEventScriptEditorClicked"
                                                Visibility="Collapsed">Open Script Editor</Button>
                                    </StackPanel>
                                    <Button x:Name="ApplyMapOverlayChangesButton"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Click="OnApplyMapOverlayChangesClicked"
                                            Visibility="Collapsed">Apply Overlay Changes</Button>
                                    <TextBlock x:Name="MapOverlayEditorStatusLabel" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SpritesSection" Header="Sprites" PreviewKeyDown="OnSpritesPreviewKeyDown">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SpriteFilterEntry" TextChanged="OnSpriteFilterChanged" VerticalContentAlignment="Center" />
                                <Button x:Name="AddSpriteAssetCommandButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Width="34"
                                        Height="30"
                                        Padding="0,-4,0,0"
                                        Content="+"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Style="{StaticResource AddButtonStyle}"
                                        ToolTip="New portrait character (a copy or blank), or rename one"
                                        Click="OnAddSpriteAssetClicked" />
                            </Grid>
                            <TreeView x:Name="SpriteTreeView" Grid.Row="1" Margin="0,10,0,0" SelectedItemChanged="OnSpriteSelectionChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type localModels:SpriteBrowserNode}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Title}" Tag="{Binding}">
                                            <TextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Split Into Side-Specific Large Displays" Click="OnSplitLargeDisplayMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Merge Large Display Variants" Click="OnMergeLargeDisplayMenuClicked" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                         </TextBlock>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                <Border Margin="0,0,10,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tool" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,10,0" />
                                        <ToggleButton x:Name="SpriteToolPencilButton" Content="Pencil" ToolTip="Pencil (P): click or drag" Padding="8,3" Margin="0,0,4,0" IsChecked="True" Click="OnSpriteToolPencilClicked" />
                                        <ToggleButton x:Name="SpriteToolEraserButton" Content="Eraser" ToolTip="Eraser (E): paints colour 0 (transparent)" Padding="8,3" Margin="0,0,4,0" Click="OnSpriteToolEraserClicked" />
                                        <ToggleButton x:Name="SpriteToolLineButton" Content="Line" ToolTip="Line (L): drag from start to end" Padding="8,3" Margin="0,0,4,0" Click="OnSpriteToolLineClicked" />
                                        <ToggleButton x:Name="SpriteToolRectangleButton" Content="Rect" ToolTip="Rectangle outline (R): drag a corner to the opposite one" Padding="8,3" Margin="0,0,4,0" Click="OnSpriteToolRectangleClicked" />
                                        <ToggleButton x:Name="SpriteToolFilledRectangleButton" Content="Fill rect" ToolTip="Filled rectangle (F): drag a corner to the opposite one" Padding="8,3" Margin="0,0,4,0" Click="OnSpriteToolFilledRectangleClicked" />
                                        <ToggleButton x:Name="SpriteToolBucketButton" Content="Bucket" ToolTip="Bucket fill (G): fills the connected area of the same colour" Padding="8,3" Margin="0,0,4,0" Click="OnSpriteToolBucketClicked" />
                                        <ToggleButton x:Name="SpriteToolPickerButton" Content="Picker" ToolTip="Picker (I): takes the colour under the cursor" Padding="8,3" Margin="0,0,4,0" Click="OnSpriteToolPickerClicked" />
                                        <Button Content="Undo" Margin="10,0,4,0" Padding="8,3" ToolTip="Undo (Ctrl+Z)" Click="OnUndoSpriteEditClicked" />
                                        <Button Content="Redo" Padding="8,3" ToolTip="Redo (Ctrl+Y)" Click="OnRedoSpriteEditClicked" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.PanelAltBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Asset" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,10,0" />
                                        <Button Content="Stage Changes" Padding="8,3" Margin="0,0,4,0" Click="OnApplySpriteChangesClicked" />
                                        <Button Content="Reset Asset" Padding="8,3" Margin="0,0,4,0" Click="OnRevertSelectedSpriteChangesClicked" />
                                        <Button Content="Reset All To ROM" Padding="8,3" Click="OnRevertAllSpriteChangesClicked" />
                                        <TextBlock x:Name="SpriteZoomValueLabel" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" Text="Zoom 4x" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Sprite Preview" FontWeight="SemiBold" FontSize="14" />
                                <Border Grid.Row="2"
                                        MinHeight="240"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Theme.PanelAltBackground}"
                                        Padding="8">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Export PNG" Click="OnExportSpritePngClicked" />
                                            <MenuItem Header="Import PNG" Click="OnImportSpritePngClicked" />
                                            <Separator />
                                            <MenuItem Header="Stage Changes" Click="OnApplySpriteChangesClicked" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ScrollViewer x:Name="SpritePreviewScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  SizeChanged="OnSpritePreviewViewportSizeChanged"
                                                  PreviewMouseDown="OnSpritePreviewScrollViewerMouseDown"
                                                  PreviewMouseMove="OnSpritePreviewScrollViewerMouseMove"
                                                  PreviewMouseUp="OnSpritePreviewScrollViewerMouseUp"
                                                  PreviewMouseWheel="OnSpritePreviewMouseWheel">
                                        <Border x:Name="SpritePreviewPaddingBorder" Padding="96" Background="Transparent">
                                            <Grid x:Name="SpritePreviewSurface"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top">
                                                <Image x:Name="SpritePreviewImage"
                                                       Stretch="Fill"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       MouseLeftButtonDown="OnSpritePreviewMouseLeftButtonDown"
                                                       MouseLeftButtonUp="OnSpritePreviewMouseLeftButtonUp"
                                                       MouseMove="OnSpritePreviewMouseMove" />
                                                <Canvas x:Name="SpriteGridCanvas"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Grid.Row="3" x:Name="SpritePatchStatusLabel" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Sprite Details" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="SpriteSummaryLabel" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    <StackPanel x:Name="LargeBotLivePreviewPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Complete Medabot Preview" FontWeight="SemiBold" />
                                        <Border Margin="0,6,0,0"
                                                Padding="6"
                                                BorderBrush="{DynamicResource Theme.Border}"
                                                BorderThickness="1"
                                                Background="{DynamicResource Theme.PanelAltBackground}">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <Image x:Name="LargeBotLivePreviewImage"
                                                       Stretch="None"
                                                       HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                    <Image.LayoutTransform>
                                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </ScrollViewer>
                                        </Border>
                                        <TextBlock x:Name="LargeBotLivePreviewLabel"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="BotBattleFacingEditorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Battle Preview Facing" FontWeight="SemiBold" />
                                        <ComboBox x:Name="BotBattleFacingComboBox"
                                                  Margin="0,6,0,0"
                                                  MinWidth="180"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectionChanged="OnBotBattleFacingSelectionChanged" />
                                        <TextBlock x:Name="BotBattleFacingHintLabel"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Text="Battle preview currently exposes the left/right mirrored presentation used by the assembled battle sprite path." />
                                    </StackPanel>
                                    <StackPanel x:Name="ParsedDescriptorEditorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Descriptor Fields" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ParsedDescriptorHeaderLabel" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                        <UniformGrid Margin="0,8,0,0" Columns="4">
                                            <TextBlock VerticalAlignment="Center">X</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorXEntry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Y</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorYEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,8,0,0" Columns="4">
                                            <TextBlock VerticalAlignment="Center">Sibling</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorSiblingEntry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Child</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorChildEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,8,0,0" Columns="4">
                                            <TextBlock VerticalAlignment="Center">Palette Bank</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorPaletteBankEntry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Width</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorWidthEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,8,0,0" Columns="4">
                                            <TextBlock VerticalAlignment="Center">Height</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorHeightEntry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Divisors</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorDivisorsEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,8,0,0" Columns="6">
                                            <TextBlock VerticalAlignment="Center">Byte 0C</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorRaw0CEntry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Byte 0D</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorRaw0DEntry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Byte 0E</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorRaw0EEntry" />
                                        </UniformGrid>
                                        <UniformGrid Margin="0,8,0,0" Columns="6">
                                            <TextBlock VerticalAlignment="Center">Byte 15</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorRaw15Entry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Byte 16</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorRaw16Entry" Margin="0,0,8,0" />
                                            <TextBlock VerticalAlignment="Center">Byte 17</TextBlock>
                                            <TextBox x:Name="ParsedDescriptorRaw17Entry" />
                                        </UniformGrid>
                                        <TextBlock x:Name="ParsedDescriptorVariantInfoLabel" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnApplyParsedDescriptorChangesClicked">Apply Descriptor Changes</Button>
                                    </StackPanel>
                                    <TextBlock Margin="0,16,0,0" Text="Palette" FontWeight="SemiBold" />
                                    <ItemsControl x:Name="SpritePaletteItemsControl" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="72" Margin="0,0,8,8">
                                                    <Button Padding="0"
                                                            Width="48"
                                                            Height="28"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                                            PreviewMouseRightButtonDown="OnSpritePaletteSwatchRightButtonDown"
                                                            Click="OnSpritePaletteSwatchClicked"
                                                            Tag="{Binding Index}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Edit Color" Click="OnEditPaletteColorMenuClicked" CommandParameter="{Binding Index}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.TextFaint}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Border Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" />
                                                    </Button>
                                                    <TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding Hex}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="SpritePaletteSummaryLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                                    <StackPanel x:Name="SpritePaletteFamilyEditorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Palette Family" FontWeight="SemiBold" />
                                        <ComboBox x:Name="SpritePaletteFamilyComboBox"
                                                  Margin="0,6,0,0"
                                                  MinWidth="160"
                                                  SelectionChanged="OnSpritePaletteFamilySelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ItemsControl ItemsSource="{Binding PreviewSwatches}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="12"
                                                                            Height="12"
                                                                            Margin="0,0,3,0"
                                                                            BorderBrush="{DynamicResource Theme.TextFaint}"
                                                                            BorderThickness="1"
                                                                            Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock x:Name="SpritePaletteFamilyHintLabel"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Theme.TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="EncountersSection" Header="Encounters" Visibility="Collapsed">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBox x:Name="EncounterFilterEntry" TextChanged="OnEncounterFilterChanged" />
                            <ListBox x:Name="EncounterCollectionView" Margin="0,10,0,0" SelectionChanged="OnEncounterSelectionChanged" DisplayMemberPath="Title" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Encounter Details" FontWeight="SemiBold" FontSize="14" />
                            <UniformGrid Margin="0,12,0,0" Columns="4">
                                <TextBlock VerticalAlignment="Center">Battle 1</TextBlock>
                                <TextBox x:Name="EncounterBattle1Entry" Margin="0,0,16,0" />
                                <TextBlock VerticalAlignment="Center">Battle 2</TextBlock>
                                <TextBox x:Name="EncounterBattle2Entry" />
                            </UniformGrid>
                            <UniformGrid Margin="0,8,0,0" Columns="4">
                                <TextBlock VerticalAlignment="Center">Battle 3</TextBlock>
                                <TextBox x:Name="EncounterBattle3Entry" Margin="0,0,16,0" />
                                <TextBlock VerticalAlignment="Center">Battle 4</TextBlock>
                                <TextBox x:Name="EncounterBattle4Entry" />
                            </UniformGrid>
                            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnApplyEncounterClicked">Apply Encounter Changes</Button>
                            <TextBox x:Name="EncounterEditor" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" MinHeight="130" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ShopsSection" Header="Shops">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBox x:Name="ShopFilterEntry" TextChanged="OnShopFilterChanged" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap">The ROM contains 15 shops. Each shop has up to four visible part sets.</TextBlock>
                            <ListBox x:Name="ShopCollectionView" Margin="0,10,0,0" SelectionChanged="OnShopSelectionChanged" ItemTemplate="{StaticResource BrowserItemChangeTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Shop Details" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Click="OnResetShopClicked">Reset</Button>
                            </Grid>
                            <TextBlock x:Name="ShopSummaryLabel" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold">Slot 1</TextBlock>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <ComboBox x:Name="ShopSlot1Entry" />
                                    <TextBlock x:Name="ShopSlot1DetailLabel" Margin="0,4,0,8" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold">Slot 2</TextBlock>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <ComboBox x:Name="ShopSlot2Entry" />
                                    <TextBlock x:Name="ShopSlot2DetailLabel" Margin="0,4,0,8" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold">Slot 3</TextBlock>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <ComboBox x:Name="ShopSlot3Entry" />
                                    <TextBlock x:Name="ShopSlot3DetailLabel" Margin="0,4,0,8" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold">Slot 4</TextBlock>
                                <StackPanel Grid.Row="3" Grid.Column="1">
                                    <ComboBox x:Name="ShopSlot4Entry" />
                                    <TextBlock x:Name="ShopSlot4DetailLabel" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="StarterSection" Header="Starter">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <TextBlock Text="Starter data is loaded from the ROM automatically. Edits below are staged immediately." TextWrapping="Wrap" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Starter Details" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Click="OnResetStarterClicked">Reset</Button>
                            </Grid>
                            <UniformGrid Margin="0,12,0,0" Columns="4">
                                <TextBlock VerticalAlignment="Center">Bot</TextBlock>
                                <ComboBox x:Name="StarterPartEntry" Margin="0,0,16,0" DisplayMemberPath="Title" SelectedValuePath="Id" />
                                <TextBlock VerticalAlignment="Center">Medal</TextBlock>
                                <ComboBox x:Name="StarterMedalEntry" DisplayMemberPath="Title" SelectedValuePath="Id" />
                            </UniformGrid>
                            <CheckBox x:Name="StarterIsFemaleSwitch" Margin="0,12,0,0" Content="Female" />
                            <TextBox x:Name="StarterEditor" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" MinHeight="130" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="FontSection" Header="Font">
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource PanelBorderStyle}" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="ExtendedFontStatusLabel"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       TextWrapping="Wrap"
                                       MaxWidth="1040" />
                            <StackPanel x:Name="FontEditorPanel" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="UseExtendedFontCheckBox"
                                              Content="Use extended font"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource Theme.TextPrimary}"
                                              Checked="OnUseExtendedFontChanged"
                                              Unchecked="OnUseExtendedFontChanged" />
                                    <Button Content="?"
                                            MinWidth="28"
                                            Padding="8,2"
                                            Margin="8,0,0,0"
                                            ToolTip="What the extended font applies and how spacing works"
                                            Click="OnExtendedFontHelpClicked" />
                                    <CheckBox x:Name="UsePtBrFontCheckBox"
                                              Content="PT-BR font (100%)"
                                              Margin="24,0,0,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource Theme.TextPrimary}"
                                              Checked="OnUsePtBrFontChanged"
                                              Unchecked="OnUsePtBrFontChanged" />
                                    <Button Content="?"
                                            MinWidth="28"
                                            Padding="8,2"
                                            Margin="8,0,0,0"
                                            ToolTip="What the PT-BR font writes"
                                            Click="OnPtBrFontHelpClicked" />
                                    <Button Content="Export Original Normal Font..."
                                            Margin="24,0,0,0"
                                            Padding="8,2"
                                            Click="OnExportNormalFontClicked" />
                                    <Button Content="Export Original Italic Font..."
                                            Margin="8,0,0,0"
                                            Padding="8,2"
                                            Click="OnExportItalicFontClicked" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource Theme.TextMuted}"
                                           TextWrapping="Wrap"
                                           MaxWidth="1040"
                                           Text="Grid: 8x16 cell of each glyph. Red line: advance (width byte); the pen moves there and the next letter starts on it. Ink right of the line is covered by the next letter." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Normal" Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <Image x:Name="FontSheetImage"
                                               Margin="0,4,0,0"
                                               Width="512"
                                               Height="512"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </StackPanel>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock Text="Italic" Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <Image x:Name="ItalicFontSheetImage"
                                               Margin="0,4,0,0"
                                               Width="512"
                                               Height="512"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ChangesSection" Header="Changes">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                        <TextBlock x:Name="ChangesSummaryLabel"
                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <ListBox x:Name="ChangesCollectionView"
                                 DisplayMemberPath="Title" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
