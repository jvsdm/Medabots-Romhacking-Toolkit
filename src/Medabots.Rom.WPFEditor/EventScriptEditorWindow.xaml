<Window x:Class="Medabots.Rom.WPFEditor.EventScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medabots.Rom.WPFEditor"
        mc:Ignorable="d"
        Title="Event Script Editor"
        Height="860"
        Width="1320"
        MinWidth="1080"
        MinHeight="680"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="EventHeaderLabel"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.TextPrimary}" />
        <TextBlock x:Name="EventPatchStatusLabel"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource Theme.TextMuted}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <ListBox x:Name="EventInstructionCollectionView"
                         SelectionChanged="OnEventInstructionSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" BorderBrush="{DynamicResource Theme.SubtleBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding AccentColor}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <DockPanel>
                                            <Border Background="{Binding CategoryBackgroundColor}"
                                                    Padding="7,2"
                                                    CornerRadius="2"
                                                    DockPanel.Dock="Left"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="{Binding CategoryTextColor}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding LabelDisplay, StringFormat={}{0}:}"
                                                       Foreground="{DynamicResource Theme.Accent}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Theme.TextPrimary}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Theme.TextMuted}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Selected Action" FontWeight="SemiBold" />
                    <TextBlock x:Name="EventActionTitleLabel"
                               Grid.Row="1"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="EventActionHintLabel"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextMuted}" />
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="EventOperationPicker"
                                  SelectionChanged="OnEventOperationSelectionChanged" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="OnEditEventLabelClicked">Edit Label</Button>
                    </Grid>
                    <local:EventStructuralActionsControl Grid.Row="4"
                                                         InsertNopBeforeClick="OnInsertNopBeforeClicked"
                                                         InsertNopAfterClick="OnInsertNopAfterClicked"
                                                         InsertSelectedOperationBeforeClick="OnInsertSelectedOperationBeforeClicked"
                                                         InsertSelectedOperationAfterClick="OnInsertSelectedOperationAfterClicked"
                                                         MoveUpClick="OnMoveInstructionUpClicked"
                                                         MoveDownClick="OnMoveInstructionDownClicked"
                                                         DeleteClick="OnDeleteInstructionClicked" />
                    <ListBox x:Name="EventArgumentCollectionView" Grid.Row="5" Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" />
                                    <TextBox Margin="0,4,0,0"
                                             Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsPlainValueEditor, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <ComboBox Margin="0,4,0,0"
                                              ItemsSource="{Binding EnumOptions}"
                                              SelectedIndex="{Binding SelectedEnumIndex}"
                                              Visibility="{Binding IsEnumEditor, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding IsMoveEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding EnumOptions}" SelectedIndex="{Binding MoveDirectionIndex}" />
                                        <TextBox Grid.Column="2" Text="{Binding MoveDistanceText, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Grid.Column="4"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsMoveUnused}"
                                                  Content="Unused" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding IsPackedTrackedObjectIdEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding TrackedObjectSlotText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding PackedFlagsText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <StackPanel Margin="0,4,0,0"
                                                Visibility="{Binding IsJumpTargetEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ComboBox ItemsSource="{Binding JumpTargetOptions}" SelectedIndex="{Binding SelectedJumpTargetIndex}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding HelpText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding HelpText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding ShowStandardHelpText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="OnApplyEventActionClicked">Apply Action Changes</Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
