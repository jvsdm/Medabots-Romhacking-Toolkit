<Window x:Class="Medabots.Rom.WPFEditor.Dialogs.PoseViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pose Viewer"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock Text="Built ROM:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,2" Margin="6,0,0,0" Click="OnBrowseRomClicked" />
            <ComboBox x:Name="SideBox" DockPanel.Dock="Right" Width="120" Margin="6,0,0,0" SelectionChanged="OnViewOptionChanged">
                <ComboBoxItem Content="Left side" IsSelected="True" />
                <ComboBoxItem Content="Right (mirrored)" />
            </ComboBox>
            <ComboBox x:Name="BotBox" DockPanel.Dock="Right" Width="200" Margin="6,0,0,0" SelectionChanged="OnViewOptionChanged" />
            <TextBlock DockPanel.Dock="Right" Text="Skeleton:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="RomPathBox" VerticalContentAlignment="Center" IsReadOnly="True" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Pose scripts (data/anim/poses)" Margin="0,0,0,4" />
                <ListBox x:Name="ScriptList" DisplayMemberPath="Display" SelectionChanged="OnScriptSelected" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <DockPanel>
                        <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="Play" Width="64" Padding="6,2" Click="OnPlayClicked" />
                        <CheckBox x:Name="LoopBox" DockPanel.Dock="Left" Content="Loop" IsChecked="True" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock x:Name="FrameText" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider x:Name="FrameSlider" Minimum="0" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                                TickFrequency="1" SmallChange="1" LargeChange="5" ValueChanged="OnFrameChanged" Margin="8,0" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                               Text="Same math as the game (checked in mGBA). The pose starts from the neutral skeleton; in battle it starts from the pose before it. The yellow cross is the selected node's joint." />
                </StackPanel>
                <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="#FF303040">
                    <Viewbox Stretch="Uniform">
                        <Image x:Name="Preview" Width="240" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Viewbox>
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Keyframe:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="KeyBox" Width="130" SelectionChanged="OnKeySelected" />
                    <TextBlock Text="Frames:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox x:Name="EndBox" Width="40" VerticalContentAlignment="Center" LostFocus="OnEndEdited" KeyDown="OnEndKeyDown"
                             ToolTip="How many frames this keyframe takes (1-255)" />
                    <TextBlock x:Name="KeyInfo" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                </DockPanel>
                <TextBlock x:Name="ShareText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource Theme.TextMuted}" />
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Theme.TextMuted}"
                           Text="Angle in degrees, + = clockwise (0x10000 = 360°; the game uses steps of 1.4°). Down/Right = offset in pixels from the joint. Edits show at the end of the keyframe." />
                <DataGrid x:Name="NodeGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OnNodeSelected"
                          CellEditEnding="OnNodeCellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Node" Binding="{Binding Node}" IsReadOnly="True" Width="52" />
                        <DataGridTextColumn Header="Part" Binding="{Binding Part}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Angle °" Binding="{Binding Degrees, UpdateSourceTrigger=LostFocus}" Width="70" />
                        <DataGridTextColumn Header="Down" Binding="{Binding Down, UpdateSourceTrigger=LostFocus}" Width="62" />
                        <DataGridTextColumn Header="Right" Binding="{Binding Right, UpdateSourceTrigger=LostFocus}" Width="62" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Theme.TextMuted}" />
            <Button Content="New pose (copy)" Padding="12,3" Margin="0,0,18,0" Click="OnNewPoseClicked"
                    ToolTip="Writes data/anim/poses/NN.json with the next free id, copied from the selected script. To use it, point a line of data/anim/pose_anims.json at it and an actor_pose of a data/anim/seq script at that line." />
            <Button x:Name="SaveButton" Content="Save poses" Padding="12,3" Margin="0,0,6,0" Click="OnSaveClicked"
                    ToolTip="Writes the edited data/anim/poses/NN.json files; Build ROM in the Decomp Project window puts them in the game" />
            <Button x:Name="CloseWindowButton" Content="Close" Padding="12,3" Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</Window>
