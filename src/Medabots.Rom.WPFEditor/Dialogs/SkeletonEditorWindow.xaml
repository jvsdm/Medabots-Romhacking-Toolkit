<Window x:Class="Medabots.Rom.WPFEditor.Dialogs.SkeletonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skeleton Editor"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock Text="Built ROM:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,2" Margin="6,0,0,0" Click="OnBrowseRomClicked" />
            <ComboBox x:Name="SideBox" DockPanel.Dock="Right" Width="120" Margin="6,0,0,0" SelectionChanged="OnViewOptionChanged">
                <ComboBoxItem Content="Left side" IsSelected="True" />
                <ComboBoxItem Content="Right (mirrored)" />
            </ComboBox>
            <ComboBox x:Name="BotBox" DockPanel.Dock="Right" Width="200" Margin="6,0,0,0" SelectionChanged="OnViewOptionChanged" />
            <TextBlock DockPanel.Dock="Right" Text="Bot:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="RomPathBox" VerticalContentAlignment="Center" IsReadOnly="True" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Molds of this bot (child / sibling)" Margin="0,0,0,4" />
                <TreeView x:Name="MoldTree" SelectedItemChanged="OnMoldSelected" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock Text="Pose:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="PoseBox" Width="200" SelectionChanged="OnPoseSelected" />
                        <TextBlock x:Name="FrameText" DockPanel.Dock="Right" Width="110" VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider x:Name="FrameSlider" Minimum="0" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                                TickFrequency="1" SmallChange="1" LargeChange="5" ValueChanged="OnFrameChanged" Margin="8,0" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                               Text="Click a piece to pick its mold. Drag it (or use the arrow keys) to move the joint; hold Shift to move the picture around its pivot instead. Yellow cross = joint (the pivot sits on it), box = the picture. Best on the neutral pose: drags go along the screen." />
                </StackPanel>
                <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="#FF303040">
                    <Viewbox Stretch="Uniform">
                        <Image x:Name="Preview" Width="240" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Focusable="True" Cursor="SizeAll"
                               MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" MouseLeftButtonUp="OnPreviewUp"
                               KeyDown="OnPreviewKeyDown" />
                    </Viewbox>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="MoldTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" Text="No mold selected" />
                    <TextBlock x:Name="MoldInfo" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource Theme.TextMuted}" />
                    <Grid x:Name="FieldGrid" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Down" Margin="4,0" Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Right" Margin="4,0" Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBlock Grid.Row="1" Text="Joint" VerticalAlignment="Center"
                                   ToolTip="Where the mold hangs from its parent's joint, in pixels (-128..127)" />
                        <TextBox x:Name="JointDownBox" Grid.Row="1" Grid.Column="1" Margin="4,2" Tag="jd" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                        <TextBox x:Name="JointRightBox" Grid.Row="1" Grid.Column="2" Margin="4,2" Tag="jr" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                        <TextBlock Grid.Row="2" Text="Pivot" VerticalAlignment="Center"
                                   ToolTip="The point of the picture that sits on the joint and that it turns around (pixels from its top-left)" />
                        <TextBox x:Name="PivotDownBox" Grid.Row="2" Grid.Column="1" Margin="4,2" Tag="pd" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                        <TextBox x:Name="PivotRightBox" Grid.Row="2" Grid.Column="2" Margin="4,2" Tag="pr" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                        <TextBlock Grid.Row="3" Text="Depth" VerticalAlignment="Center"
                                   ToolTip="Added to the parent's depth: higher = further back (drawn under the others)" />
                        <TextBox x:Name="DepthBox" Grid.Row="3" Grid.Column="1" Margin="4,2" Tag="dp" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                        <TextBlock Grid.Row="4" Text="Child / sibling" VerticalAlignment="Center"
                                   ToolTip="First child mold (hangs from this one's joint and turns with it) and next sibling (same parent); 0 = none" />
                        <TextBox x:Name="ChildBox" Grid.Row="4" Grid.Column="1" Margin="4,2" Tag="ch" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                        <TextBox x:Name="SiblingBox" Grid.Row="4" Grid.Column="2" Margin="4,2" Tag="sb" LostFocus="OnFieldEdited" KeyDown="OnFieldKeyDown" />
                    </Grid>
                    <Button x:Name="ResetButton" Content="Reset this mold" HorizontalAlignment="Left" Padding="10,2" Margin="0,10,0,0"
                            IsEnabled="False" Click="OnResetClicked"
                            ToolTip="Takes the mold out of data/anim/molds.json and back to the value it has in the loaded ROM" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OwnButton" Content="Own mold for this bot" Padding="10,2" IsEnabled="False" Click="OnOwnClicked"
                                ToolTip="Makes a private copy of this mold for the shown bot: from then on, editing it moves only this bot (data/anim/molds.json custom / use)" />
                        <Button x:Name="SharedButton" Content="Back to shared mold" Padding="10,2" Margin="6,0,0,0" IsEnabled="False" Click="OnSharedClicked"
                                ToolTip="The bot goes back to the shared mold; its own copy is dropped when no bot uses it" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                               Text="A mold is shared: every part drawn with it moves too (see the count above). Core = the game's table (Medabots parts); Navi = the Navi records of a Navi build. Edits go to data/anim/molds.json; Build ROM in Decomp Project puts them in the game. To change one bot only, give it its own mold (a private copy: same picture, its own joint, pivot and depth)." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Theme.TextMuted}" />
            <Button Content="Save" Padding="12,3" Margin="0,0,6,0" Click="OnSaveClicked"
                    ToolTip="Writes data/anim/molds.json" />
            <Button x:Name="CloseWindowButton" Content="Close" Padding="12,3" Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</Window>
