<Window x:Class="Medabots.Rom.WPFEditor.Dialogs.DecompProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decomp Project"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="ProjectBar" Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock Text="Project folder:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Padding="10,2" Margin="6,0,0,0" Click="OnBrowseClicked" />
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="Reload" Padding="10,2" Margin="6,0,0,0" Click="OnReloadClicked" />
            <TextBox x:Name="PythonBox" DockPanel.Dock="Right" Width="260" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="Python used to run tools/decomp_build.py" />
            <TextBlock DockPanel.Dock="Right" Text="Python:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="ProjectPathBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="OnFilterChanged"
                         ToolTip="Filter by pack, file name or bot name" />
                <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                           Text="● in data/expansion_bots.txt   ○ not in the list   * unsaved" />
                <ListBox x:Name="BotList" DisplayMemberPath="Display" SelectionChanged="OnBotSelected" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="NameBox" Width="220" VerticalContentAlignment="Center" LostFocus="OnNameEdited" />
                    <TextBlock x:Name="BotInfoText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                </StackPanel>
                <TabControl x:Name="PartTabs" />
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,6">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Theme.TextMuted}" />
            <Button Content="New bot..." Padding="12,3" Margin="0,0,18,0" Click="OnNewBotClicked"
                    ToolTip="A new bot in data/bots (pack binario) from one of the game's bots: its stats and pictures to start with" />
            <Button x:Name="MoveEditorButton" Content="Move Editor..." Padding="12,3" Margin="0,0,6,0" Click="OnMoveEditorClicked"
                    ToolTip="Edits the moves: battle scripts, animation lines and which part plays which move (works with or without Navi bots)" />
            <Button x:Name="SkeletonEditorButton" Content="Skeleton Editor..." Padding="12,3" Margin="0,0,6,0" Click="OnSkeletonEditorClicked"
                    ToolTip="Edits the battle skeleton: each mold's joint, pivot, depth and links (data/anim/molds.json)" />
            <Button x:Name="PoseViewerButton" Content="Pose Viewer..." Padding="12,3" Margin="0,0,18,0" Click="OnPoseViewerClicked"
                    ToolTip="Plays and edits the battle poses (data/anim/poses) on the Tinpet skeleton of the latest build" />
            <Button x:Name="SaveButton" Content="Save changes" Padding="12,3" Margin="0,0,6,0" Click="OnSaveClicked" />
            <Button x:Name="BuildButton" Content="Build ROM" Padding="12,3" Margin="0,0,6,0" Click="OnBuildClicked"
                    ToolTip="Saves, then runs tools/decomp_build.py (generator + make) into a new build/scratch folder" />
            <Button x:Name="CloseWindowButton" Content="Close" Padding="12,3" Click="OnCloseClicked" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
