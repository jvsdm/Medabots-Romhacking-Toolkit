<Window x:Class="Medabots.Rom.WPFEditor.Dialogs.NewBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Medabots"
        Width="1480"
        Height="860"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- body type + name -->
        <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Padding="10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Body type (base bot)" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="BaseComboBox" Grid.Column="1" SelectionChanged="OnBaseChanged" />
                <TextBlock Grid.Column="3" Text="Name" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBox x:Name="BotNameTextBox" Grid.Column="4" Padding="4,3" />
                <TextBlock Grid.Column="5" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                           Text="The body type gives the pieces (shape, joints, animation and mini sprite). Every field starts with the base bot's values: change what you want, load PNGs for the pieces you redraw." />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- bots of the list -->
            <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Bots to add" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="+ New bot" Padding="8,4" FontWeight="SemiBold" Style="{StaticResource AddButtonStyle}" Click="OnNewDraftClicked" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="Duplicate" Padding="6,3" Margin="0,0,3,0" Click="OnDuplicateDraftClicked" />
                            <Button Content="Remove" Padding="6,3" Margin="3,0,0,0" Click="OnRemoveDraftClicked" />
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="Move up" Padding="6,3" Margin="0,0,3,0" Click="OnMoveDraftUpClicked" />
                            <Button Content="Move down" Padding="6,3" Margin="3,0,0,0" Click="OnMoveDraftDownClicked" />
                        </UniformGrid>
                    </StackPanel>
                    <ListBox x:Name="DraftsListBox" SelectionChanged="OnDraftSelectionChanged" />
                </DockPanel>
            </Border>

            <!-- parts: names and stats -->
            <Border Grid.Column="2" Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel x:Name="PartsPanel" />
                </ScrollViewer>
            </Border>

            <!-- pieces -->
            <Border Grid.Column="4" Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,0">
                        <Button Content="Load pictures from folder..." Padding="10,4" Click="OnLoadFolderClicked" />
                        <Button Content="Export pictures as templates..." Padding="10,4" Margin="8,0,0,0" Click="OnExportTemplatesClicked" />
                        <Button Content="Reset all pictures" Padding="10,4" Margin="8,0,0,0" Click="OnResetAllClicked" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="10,6,10,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                               Text="Each picture must keep the piece's size; transparent pixels stay transparent. A part's pieces share one palette of 15 colours (more are merged, nearest shades first). PNG names match the exported templates, so a folder of edited templates loads in one go." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel x:Name="SlotsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open bot list..." Padding="10,5" Click="OnOpenListClicked" />
                <Button Content="Save bot list" Padding="10,5" Margin="6,0,0,0" Click="OnSaveListClicked" />
                <Button Content="Save as..." Padding="10,5" Margin="6,0,0,0" Click="OnSaveListAsClicked" />
                <Button Content="Import bot JSON..." Padding="10,5" Margin="16,0,0,0" Click="OnImportJsonClicked" />
                <Button Content="Export bot JSON..." Padding="10,5" Margin="6,0,0,0" Click="OnSaveJsonClicked" />
                <Button x:Name="AddButton" Content="Add all to ROM..." Padding="16,5" Margin="16,0,0,0" FontWeight="SemiBold" Click="OnAddClicked" />
                <Button Content="Close" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}" />
        </DockPanel>
    </Grid>
</Window>
